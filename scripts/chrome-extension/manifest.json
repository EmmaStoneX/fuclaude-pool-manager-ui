{
    "manifest_version": 3,
    "name": "FuClaude 增强工具",
    "version": "2.4",
    "description": "支持 Claude 官网和 FuClaude 站点 - 返回 Pool Manager 按钮 + 会话导出功能",
    "permissions": [],
    "host_permissions": [
        "https://claude.zxvmax.com/*",
        "https://claude.ai/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://claude.zxvmax.com/*",
                "https://claude.ai/*"
            ],
            "js": [
                "jszip.min.js",
                "content.js"
            ],
            "css": [
                "styles.css"
            ],
            "run_at": "document_end"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}